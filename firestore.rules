rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 대시보드에 접근할 수 있는 Google 계정 (팀원은 대시보드 설정 > 로그인 계정에서 추가)
    // 관리자(고정) — 여기 이메일은 대시보드 설정에서 지울 수 없음
    function owner() {
      return request.auth.token.email in [
          'larc30730@gmail.com'
        ];
    }
    // 대시보드 설정 > 로그인 계정에서 추가한 계정 (meta/access 문서의 emails)
    function added() {
      return exists(/databases/$(database)/documents/meta/access)
        && request.auth.token.email in get(/databases/$(database)/documents/meta/access).data.emails;
    }
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (owner() || added());
    }

    // 읽기: 등록된 계정 모두 / 쓰기(업체·사업 등록·수정, 설정, 스캔 요청): 관리자만
    match /{document=**} {
      allow read: if allowed();
      allow write: if allowed() && owner();
    }
    // 팀원은 이슈의 '확인 완료 / 관련 없음' 처리만 할 수 있음 (다른 칸은 못 바꿈)
    match /findings/{id} {
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewed_by', 'reviewed_at', 'review_note']);
    }
  }
}
